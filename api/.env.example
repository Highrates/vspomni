PORT=3011
# Прод за nginx: 127.0.0.1 (не светить Nest наружу). Локально — 0.0.0.0.
HOST=127.0.0.1
DATABASE_URL="postgresql://vspomni:vspomni@localhost:55432/vspomni?schema=public"
JWT_SECRET="change-me-in-production-vspomni"
JWT_EXPIRES_IN="12h"
FRONTEND_PUBLIC_URL="http://localhost:3001"
# Prod: обязательный allowlist (не пустой / не fail-open). Пример:
# CORS_ORIGIN="https://vspomni.store,https://www.vspomni.store"
CORS_ORIGIN="http://localhost:3020,http://localhost:3001,http://127.0.0.1:3001"
ADMIN_SEED_EMAIL="admin@vspomni.store"
ADMIN_SEED_PASSWORD="change-me-admin"

# ЮKassa (см. deploy/CHECKOUT-PROD.md)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
# Prod: true (вместе с TRUST_PROXY=1). Без secret в production IP-check включается сам.
YOOKASSA_WEBHOOK_CHECK_IP=true

ORDER_AWAITING_TTL_MINUTES=60
ORDER_PAY_SECRET=

# REDIS_URL=redis://127.0.0.1:6379

LOCAL_UPLOADS_DIR=
LOCAL_UPLOADS_PUBLIC_URL="https://vspomni.store"

# Обязательно на проде: без SMTP password-reset/OTP не уходят (ETL-buyer без пароля не войдёт).
# Яндекс: SMTP_USER = полный ящик, SMTP_PASSWORD = пароль приложения.
# Яндекс ID (OAuth для витрины: /login → oauth.yandex.ru → /login?code&state)
# Redirect URI в кабинете oauth.yandex.ru: https://vspomni.store/login
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# По умолчанию: FRONTEND_PUBLIC_URL + /login
YANDEX_OAUTH_REDIRECT_URI=
FRONTEND_PUBLIC_URL=https://vspomni.store

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vspomni <noreply@vspomni.store>"
MAIL_REPLY_TO=info@vspomni.store

# Telegram: уведомления staff о оплаченных заказах (получатель: /start у бота)
TELEGRAM_BOT_TOKEN=
# Через запятую: chat_id (число)
TELEGRAM_ORDER_CHAT_IDS=
# Если с VPS api.telegram.org недоступен — Cloudflare Worker (deploy/telegram-api-proxy-worker.js)
# TELEGRAM_API_BASE=https://vspomni-tg-proxy.<account>.workers.dev
# Опционально: ссылка в админку в сообщении
# ADMIN_PUBLIC_URL=https://admin.vspomni.store

# За nginx на проде обязательно 1 (иначе IP-check webhook ломается → заказ не PAID).
TRUST_PROXY=1
REGISTRATION_TOKEN_SECRET=

SHIPPING_REQUIRE_SERVER_REPRICE=true
SHIPPING_QUOTE_TTL_SECONDS=900

# Яндекс Доставка в checkout (server reprice на Nest; тот же токен, что Front BFF)
YANDEX_DELIVERY_ENABLED=false
YANDEX_DELIVERY_TOKEN=
YANDEX_PLATFORM_SOURCE_STATION_ID=
YANDEX_DELIVERY_WAREHOUSE_ID=
YANDEX_DELIVERY_WAREHOUSE_LAT=
YANDEX_DELIVERY_WAREHOUSE_LNG=
YANDEX_DELIVERY_WAREHOUSE_FULLNAME=

CDEK_ACCOUNT=
CDEK_SECURE=
CDEK_SHIPMENT_POINT=MSK12
CDEK_FROM_CITY_CODE=44
