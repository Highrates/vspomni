# ETL source = Vspomni Saleor dump. NEVER saleor_etl (Miraflores).
SALEOR_DATABASE_URL=postgresql:///vspomni_saleor_etl
# Absolute stock for all variants (0 = keep Saleor warehouse qty). Default in migrate.mjs = 1000.
# ETL_FORCE_STOCK=1000
SALEOR_CHANNEL=vspomni-site
SALEOR_GRAPHQL_URL=https://vspomni.store/graphql/
SALEOR_MEDIA_BASE_URL=https://vspomni.store/media
SALEOR_MEDIA_ROOT=/Users/ap/Projects/Vspomni/scripts/etl/.media-cache
# Prefer local media cache over GraphQL during offline ETL:
ETL_SKIP_GRAPHQL_MEDIA=1

# Target Nest/Prisma (docker vspomni_db on 55432 — not Mira :5432)
VSPOMNI_DATABASE_URL=postgresql://vspomni:vspomni@localhost:55432/vspomni
VSPOMNI_UPLOADS_DIR=/Users/ap/Projects/Vspomni/api/.data/local-uploads
VSPOMNI_UPLOADS_PUBLIC_URL=http://127.0.0.1:3011

# Aromas → CatalogTag (page type vse-aromaty); product attr aromat links ProductCatalogTag
